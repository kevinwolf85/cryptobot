# Trading
MARKET_DATA_BASE_URL=https://api.binance.us
SYMBOL=BTCUSDT
INTERVAL=1m
FAST_EMA=12
SLOW_EMA=26
SIGNAL_EMA=9
LOOKBACK_CANDLES=200
POLL_SECONDS=20
TRADE_USD_SIZE=50
VOLUME_WINDOW=40
VOLUME_RATIO_THRESHOLD=1.2

# Paper account
PAPER_STARTING_CASH=10000
PAPER_STATE_FILE=state/paper_account.json

# Safety: keep false unless you implement and audit live execution
LIVE_TRADING_ENABLED=false

# Web server
HOST=127.0.0.1
PORT=8080
